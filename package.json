{
  "name": "onex-erp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "ONEX ERP - Arabic offline-first accounting and inventory",
  "scripts": {
    "test": "node --test",
    "build:web": "vite build",
    "build:windows": "npm run build:web && electron-builder --win nsis --x64 --publish never",
    "build:android": "npm run build:web && npx cap add android && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "6.0.2",
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0",
    "better-sqlite3": "11.5.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "com.onex.erp",
    "productName": "ONEX ERP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/db/schema.sql",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ONEX-ERP-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
